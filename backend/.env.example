NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Supabase PostgreSQL (usa conexión directa o Session pooler en 5432; nunca Transaction pooler 6543)
DB_HOST=YOUR_PROJECT.supabase.co
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME
DB_DATABASE=postgres
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# JWT: secretos distintos, aleatorios y de 32+ caracteres
JWT_ACCESS_SECRET=CHANGE_ME_WITH_RANDOM_32_PLUS_CHARACTERS
JWT_REFRESH_SECRET=CHANGE_ME_WITH_DIFFERENT_RANDOM_32_PLUS_CHARACTERS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Redis/Bull permanece requerido por la cola FE de NestJS
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Facturación electrónica: MOCK no envía a SUNAT/OSE real
OSE_PROVIDER=mock
OSE_ENDPOINT=https://api.nubefact.com/api/v1/sandbox
OSE_TOKEN=CHANGE_ME
OSE_MOCK=true  # No cambiar a false: este ZIP no incluye adaptador OSE real
FE_XML_DIR=./storage/fe/xml
FE_CDR_DIR=./storage/fe/cdr
FORMATO_TICKET_DEFAULT=80mm

# Correo SMTP (secreto de servidor, nunca usar VITE_)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Mi Carrito POS <no-responder@example.com>

# WhatsApp Business Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v26.0
# Plantilla aprobada en Meta: debe tener dos variables de texto en el cuerpo (comprobante, total)
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=es_PE
WHATSAPP_VERIFY_TOKEN=

# Automatización de comprobantes (se ejecuta al finalizar el envío FE)
ENVIO_AUTOMATICO_EMAIL=false
ENVIO_AUTOMATICO_WHATSAPP=false

# Para Cloudflare Worker Cron Trigger. Compartir como secret, nunca publicar.
CRON_SECRET=CHANGE_ME_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
