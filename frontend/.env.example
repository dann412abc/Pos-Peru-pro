# Cloudflare Pages (producción): mantener la API en el mismo dominio mediante Pages Functions.
VITE_API_URL=/api
VITE_DEMO_MODE=false

# Desarrollo local: descomentar y usar cuando NestJS corre en el puerto 3000.
# VITE_API_URL=http://localhost:3000/api

# Edge API (Cloudflare Pages Functions). Configurar en dashboard como variables
# server-side, no como VITE_:
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<publishable-or-anon-key>
# SUPABASE_RPC_ALLOWLIST=  # mantener vacía hasta aprobar RPC concretas
# API_ORIGIN queda sin definir en el despliegue objetivo sin VPS; configurarla reactiva el backend heredado.

# Estado 1.44.76: proveedor heredado por compatibilidad. No cambiar a supabase hasta cerrar las brechas del informe AUDITORIA_NO_VPS_1.44.76.md.
# El modo Supabase se habilita primero en staging, una vez aplicadas y probadas las RPC y RLS necesarias.
VITE_AUTH_PROVIDER=legacy
# Bloqueado por defecto. Solo staging tras completar pruebas transaccionales y habilitar RPC.
VITE_SUPABASE_SALES_ENABLED=false
