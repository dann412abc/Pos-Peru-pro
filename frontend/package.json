{
  "name": "mi-carrito-pos-frontend",
  "private": true,
  "version": "1.44.79",
  "type": "module",
  "description": "Mi Carrito POS - Sistema de facturación electrónica POS para Perú",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:pages-proxy": "node --test tests/api/proxy.test.js",
    "test:cash-contract": "node --test ../supabase/migrations-preview/202611070042_cash_register_summary_auth.test.mjs ../supabase/migrations-preview/202611070046_cash_register_end_to_end_contract.test.mjs",
    "test:purchases-contract": "node --test ../supabase/migrations-preview/202611090005_purchase_receive_auth.test.mjs",
    "test:purchase-sales-flow": "node --test ../supabase/migrations-preview/202611090047_purchase_sales_lot_flow_contract.test.mjs",
    "test:edge-smoke": "vitest run tests/api/edge/edge.test.js",
    "test:returns-contract": "cd .. && node --test supabase/migrations-preview/202611070043_cash_register_lifecycle_auth.test.mjs supabase/migrations-preview/202611070045_cash_refund_reconciliation_auth.test.mjs supabase/migrations-preview/202611090003_returns_register_fefo_auth.test.mjs supabase/migrations-preview/202611090012_returns_transactional_writer_auth.test.mjs frontend/tests/api/edge/returns-register-contract.test.mjs frontend/tests/api/edge/returns-supabase-gate.test.mjs"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "dexie": "^4.0.4",
    "lucide-react": "^0.378.0",
    "qrcode": "^1.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
